[2026-09-26 18:08:08] [claude-sdk] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01V8vNLN7kcjtkYoZGtZtbNY","type":"tool_result","content":"14\t/// **焼いた瞬間の1コマ**しか写らない。動きそのものはここでは確かめられない。\n15\tenum Snapshot {\n16\t\n17\t    @MainActor\n18\t    static func write(to path: String, size: CGSize, transcript: String? = nil, gate: Bool = false,\n19\t                      approval: Bool = false) {\n20\t        let cockpit = Cockpit()\n21\t        // 空のまま焼くと外枠しか写らない。実 transcript を1本流し込むと、\n22\t        // エージェントの行・ファイルの格子・門まで入った本物の1コマになる\n23\t        if let transcript { feed(cockpit, from: transcript) }\n24\t        if gate { stopOneGate(cockpit) }\n25\t        // 承認の板の見え方。実機の can_use_tool の形そのまま（実行されるのは書き換えた方）\n26\t        if approval {\n27\t            cockpit.loadApprovalsForProbe([Approval(\n28\t                id: \"probe\", session: cockpit.selectedSession ?? \"probe\", tool: \"Bash\",\n29\t                detail: \"Create file at /tmp/at22-spike-file\",\n30\t                input: #\"{\"command\":\"touch /tmp/at22-spike-file\",\"description\":\"Create file at /tmp/at22-spike-file\"}\"#,\n31\t                at: Date(timeIntervalSinceNow: -8))])\n32\t        }\n33\t\n34\t        let renderer = ImageRenderer(content:\n35\t            CockpitView(cockpit: cockpit)\n36\t                .frame(width: size.width, height: size.height)\n37\t                .environment(\\.colorScheme, .dark))\n38\t        // Retina で焼く。1px の縁と工具目は等倍だと潰れて「あるのか無いのか」が読めない\n39\t        renderer.scale = 2\n40\t        emit(renderer, to: path, label: \"\\(Int(size.width))×\\(Int(size.height))\")\n41\t    }\n42\t\n43\t    /// レビューの画面を焼く。`AT22 --shot <path> W H --review`。差分は実機の git を叩かず、決まった見本を使う\n44\t    @MainActor\n45\t    static func writeReview(to path: String, size: CGSize) {\n46\t        let diff = \"\"\"\n47\t        diff --git a/Sources/App/Login.swift b/Sources/App/Login.swift\n48\t        --- a/Sources/App/Login.swift\n49\t        +++ b/Sources/App/Login.swift\n50\t